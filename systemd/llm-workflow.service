[Unit]
Description=LLMCtl pluggable workflow data plane
Documentation=https://github.com/chatop2020/LLMCtl
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=llm-workflow
Group=llm-workflow
EnvironmentFile=-/etc/llm-cluster/runtime-proxy.env
EnvironmentFile=/etc/llm-cluster/workflow.env
EnvironmentFile=/etc/llm-cluster/secrets.env
ExecStart=/usr/local/lib/llm-cluster/workflowd/llm-workflowd --config /var/lib/llm-cluster/workflow/workflow.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
TimeoutStartSec=30
TimeoutStopSec=30
UMask=0027

NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/var/lib/llm-cluster/workflow
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
