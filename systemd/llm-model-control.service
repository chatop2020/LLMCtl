[Unit]
Description=LLMCtl model deployment control service
Documentation=https://github.com/chatop2020/LLMCtl
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
EnvironmentFile=-/etc/llm-cluster/cluster.env
EnvironmentFile=-/etc/llm-cluster/secrets.env
EnvironmentFile=-/etc/llm-cluster/proxy.env
Environment=LLM_MODEL_CONTROL_GROUP=llm-account
ExecStart=/usr/local/lib/llm-cluster/model_deployment.py serve
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=30s
RuntimeDirectory=llm-cluster
RuntimeDirectoryMode=0755
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectClock=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
