[Unit]
Description=LLMCtl direct Worker keep-warm probe
After=llm-cluster.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/llmctl _keepwarm-tick
TimeoutStartSec=10min
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/llm-cluster/keepwarm
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
MemoryDenyWriteExecute=true
